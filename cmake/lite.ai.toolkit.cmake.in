# lite.ai.toolkit 依赖路径解析
#
# 由 lite.ai.toolkit-config.cmake 引入，负责查找传递依赖并收集路径变量。
# 不直接创建目标（目标由 -config.cmake 创建），不污染全局作用域。
#
# 输出变量（供 -config.cmake 设置 IMPORTED target 属性）：
#   LITE_AI_LIB_DIR        — 主库 .so 所在目录
#   Lite_AI_INCLUDE_DIRS   — 所有头文件搜索路径
#   Lite_AI_LIBS_DIRS      — 所有库文件搜索路径
#   Lite_AI_LIBS           — 所有需链接的库名称/路径

cmake_minimum_required(VERSION 3.12)
include_guard(GLOBAL)

# ===== 构建时特性标志（由 configure_file 替换）=====
set(_LITE_AI_ENABLE_ONNXRUNTIME @ENABLE_ONNXRUNTIME@)
set(_LITE_AI_ENABLE_MNN        @ENABLE_MNN@)
set(_LITE_AI_ENABLE_NCNN       @ENABLE_NCNN@)
set(_LITE_AI_ENABLE_TNN        @ENABLE_TNN@)
set(_LITE_AI_ENABLE_TENSORRT   @ENABLE_TENSORRT@)
set(_LITE_AI_CUDA_DIR          "@CUDA_DIR@")
set(_LITE_AI_TENSORRT_DIR      "@TensorRT_DIR@")

# ===== 平台校验 =====
if(NOT (UNIX AND NOT APPLE))
  message(FATAL_ERROR "lite.ai.toolkit >= 0.2 仅支持 Linux")
endif()

if(NOT _LITE_AI_ENABLE_ONNXRUNTIME AND NOT _LITE_AI_ENABLE_MNN)
  message(FATAL_ERROR "至少需要启用 ONNXRuntime 或 MNN 后端之一")
endif()

# ===== 安装前缀推导 =====
# 从 config 文件位置向上推导到安装根目录
# 标准布局：lib/cmake/lite.ai.toolkit/ → 向上 3 层
# vcpkg 布局：share/lite.ai.toolkit/   → 向上 2 层（由 portfile 修补）
get_filename_component(_LITE_AI_CMAKE_DIR "${CMAKE_CURRENT_LIST_FILE}" PATH)
get_filename_component(_LITE_AI_PREFIX "${_LITE_AI_CMAKE_DIR}/../../.." ABSOLUTE)

set(LITE_AI_LIB_DIR "${_LITE_AI_PREFIX}/lib")

# ===== 收集路径变量 =====
set(Lite_AI_INCLUDE_DIRS "${_LITE_AI_PREFIX}/include")
set(Lite_AI_LIBS_DIRS    "${LITE_AI_LIB_DIR}")
set(Lite_AI_LIBS         lite.ai.toolkit)

# ===== 传递依赖 =====
include(CMakeFindDependencyMacro)

# --- OpenCV ---
# 优先 find_dependency（vcpkg / 系统安装均可），fallback 到内嵌 third_party/
find_dependency(OpenCV COMPONENTS core imgcodecs imgproc video videoio)
if(OpenCV_FOUND)
  list(APPEND Lite_AI_INCLUDE_DIRS ${OpenCV_INCLUDE_DIRS})
  list(APPEND Lite_AI_LIBS ${OpenCV_LIBS})
else()
  set(_lite_ai_tp "${_LITE_AI_PREFIX}/third_party")
  list(APPEND Lite_AI_INCLUDE_DIRS "${_lite_ai_tp}/opencv/include/opencv4")
  list(APPEND Lite_AI_LIBS_DIRS    "${_lite_ai_tp}/opencv/lib")
  list(APPEND Lite_AI_LIBS opencv_core opencv_imgcodecs opencv_imgproc opencv_video opencv_videoio)
  unset(_lite_ai_tp)
endif()

# --- ONNXRuntime ---
if(_LITE_AI_ENABLE_ONNXRUNTIME)
  list(APPEND Lite_AI_INCLUDE_DIRS "${_LITE_AI_PREFIX}/include/onnxruntime")
  list(APPEND Lite_AI_LIBS onnxruntime)
endif()

# --- MNN（内嵌第三方）---
if(_LITE_AI_ENABLE_MNN)
  set(_lite_ai_tp "${_LITE_AI_PREFIX}/third_party")
  list(APPEND Lite_AI_INCLUDE_DIRS "${_lite_ai_tp}/MNN/include")
  list(APPEND Lite_AI_LIBS_DIRS    "${_lite_ai_tp}/MNN/lib")
  list(APPEND Lite_AI_LIBS MNN)
  unset(_lite_ai_tp)
endif()

# --- TNN（内嵌第三方）---
if(_LITE_AI_ENABLE_TNN)
  set(_lite_ai_tp "${_LITE_AI_PREFIX}/third_party")
  list(APPEND Lite_AI_INCLUDE_DIRS "${_lite_ai_tp}/TNN/include")
  list(APPEND Lite_AI_LIBS_DIRS    "${_lite_ai_tp}/TNN/lib")
  list(APPEND Lite_AI_LIBS TNN)
  unset(_lite_ai_tp)
endif()

# --- ncnn（内嵌第三方）---
if(_LITE_AI_ENABLE_NCNN)
  set(_lite_ai_tp "${_LITE_AI_PREFIX}/third_party")
  list(APPEND Lite_AI_INCLUDE_DIRS "${_lite_ai_tp}/ncnn/include")
  list(APPEND Lite_AI_LIBS_DIRS    "${_lite_ai_tp}/ncnn/lib")
  list(APPEND Lite_AI_LIBS ncnn)
  unset(_lite_ai_tp)
endif()

# --- TensorRT + CUDA ---
if(_LITE_AI_ENABLE_TENSORRT)
  # TensorRT 头文件：优先使用随库安装的，否则用构建时记录的系统路径
  if(EXISTS "${_LITE_AI_PREFIX}/include/tensorrt")
    list(APPEND Lite_AI_INCLUDE_DIRS "${_LITE_AI_PREFIX}/include/tensorrt")
  else()
    list(APPEND Lite_AI_INCLUDE_DIRS "${_LITE_AI_TENSORRT_DIR}/include")
  endif()

  list(APPEND Lite_AI_INCLUDE_DIRS "${_LITE_AI_CUDA_DIR}/include")
  list(APPEND Lite_AI_LIBS_DIRS    "${_LITE_AI_TENSORRT_DIR}/lib")

  # 使用绝对路径避免链接到系统中其他版本的 TensorRT（如 CUDA 目录下的 libnvinfer.so.8）
  list(APPEND Lite_AI_LIBS
    cuda cudart
    "${_LITE_AI_TENSORRT_DIR}/lib/libnvinfer.so"
    "${_LITE_AI_TENSORRT_DIR}/lib/libnvonnxparser.so"
    "${_LITE_AI_TENSORRT_DIR}/lib/libnvinfer_plugin.so"
  )
endif()

# ===== 旧式变量兼容（已弃用，建议使用 lite.ai.toolkit::lite.ai.toolkit 目标）=====
set(lite.ai.toolkit_INCLUDE_DIRS ${Lite_AI_INCLUDE_DIRS})
set(lite.ai.toolkit_LIBS_DIRS    ${Lite_AI_LIBS_DIRS})
set(lite.ai.toolkit_LIBS         ${Lite_AI_LIBS})

# ===== 清理内部变量 =====
unset(_LITE_AI_CMAKE_DIR)
unset(_LITE_AI_PREFIX)
unset(_LITE_AI_ENABLE_ONNXRUNTIME)
unset(_LITE_AI_ENABLE_MNN)
unset(_LITE_AI_ENABLE_NCNN)
unset(_LITE_AI_ENABLE_TNN)
unset(_LITE_AI_ENABLE_TENSORRT)
unset(_LITE_AI_CUDA_DIR)
unset(_LITE_AI_TENSORRT_DIR)
